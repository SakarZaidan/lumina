      "type": "Text",
      "properties": {
        "content": "Feedforward Neural Network",
        "x": 60, "y": 50, "font_id": "sans", "font_size": 30,
        "color": "#E8EAED", "opacity": 0, "z_index": 10
      }
    },
    "lbl_input": {
      "type": "Text",
      "properties": {
        "content": "Input Layer (3)",
