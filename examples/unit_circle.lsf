        "font_id": "sans",
        "color": "#F78166", "z_index": 5, "opacity": 0
      }
    },
    "cos_label": {
      "type": "Text",
      "properties": {
        "content": "cos(x)",
        "x": 1635, "y": 510, "font_size": 24,
        "font_id": "sans",
        "color": "#7EE787", "z_index": 5, "opacity": 0
      }
    },
    "identity_formula": {
      "type": "LaTeX",
      "properties": {
        "expression": "sin^2(x) + cos^2(x) = 1",
