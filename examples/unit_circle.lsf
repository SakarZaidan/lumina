    ],
    "images": []
  },
  "objects": {
    "title": {
      "type": "Text",
      "properties": {
        "content": "The Unit Circle",
        "x": 490, "y": 145, "font_size": 72,
        "font_id": "sans",
        "color": "#E6EDF3", "z_index": 10, "opacity": 0
      }
    },
    "subtitle": {
      "type": "Text",
      "properties": {
        "content": "Where Trigonometry Lives",
        "x": 595, "y": 210, "font_size": 34,
        "font_id": "sans",
        "color": "#8B949E", "z_index": 10, "opacity": 0
      }
    },
    "axes_main": {
      "type": "Axes",
      "properties": {
        "x_range": [-5, 5],
        "y_range": [-3, 3],
        "x": 260, "y": 780,
        "scale": 80,
        "x_step": 1, "y_step": 1,
        "grid": false,
        "color": "#3D5A80",
        "z_index": 1, "opacity": 0
      }
    },
    "unit_circle": {
      "type": "Circle",
      "properties": {
        "cx": 660, "cy": 540,
        "radius": 80,
        "fill": "#0D1117",
        "stroke": "#58A6FF",
        "stroke_width": 2.5,
        "z_index": 2, "opacity": 0
      }
    },
    "origin_dot": {
      "type": "Circle",
      "properties": {
        "cx": 660, "cy": 540,
        "radius": 5,
        "fill": "#E6EDF3",
        "z_index": 5, "opacity": 0
      }
    },
    "radius_label": {
      "type": "Text",
      "properties": {
        "content": "r = 1",
        "x": 695, "y": 507, "font_size": 22,
        "font_id": "sans",
        "color": "#E6EDF3", "z_index": 8, "opacity": 0
      }
    },
    "angle_group": {
      "type": "Group",
      "properties": {
        "children": ["radius_line", "angle_tip"],
        "x": 660, "y": 540,
        "scale": 1, "rotation": 0,
        "z_index": 6, "opacity": 0
      }
    },
    "radius_line": {
      "type": "Line",
      "properties": {
        "x1": 0, "y1": 0,
        "x2": 80, "y2": 0,
        "stroke": "#FFA657", "stroke_width": 2.5,
        "z_index": 1, "opacity": 1
      }
    },
    "angle_tip": {
      "type": "Circle",
      "properties": {
        "cx": 80, "cy": 0,
        "radius": 7,
        "fill": "#FFA657",
        "z_index": 2, "opacity": 1
      }
    },
    "plot_axes": {
      "type": "Axes",
      "properties": {
        "x_range": [0, 6.5],
        "y_range": [-1.5, 1.5],
        "x": 1100, "y": 660,
        "scale": 80,
        "x_step": 1, "y_step": 0.5,
        "grid": true,
        "color": "#3D5A80",
        "z_index": 1, "opacity": 0
      }
    },
    "sin_plot": {
      "type": "Plot",
      "properties": {
        "function_str": "sin(x)",
        "axes_id": "plot_axes",
        "color": "#F78166",
        "stroke_width": 3,
        "sample_count": 300,
        "z_index": 3, "opacity": 0
      }
    },
    "cos_plot": {
      "type": "Plot",
      "properties": {
        "function_str": "cos(x)",
        "axes_id": "plot_axes",
        "color": "#7EE787",
        "stroke_width": 3,
