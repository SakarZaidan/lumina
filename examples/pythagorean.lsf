{
  "version": "1.0",
  "meta": {
    "title": "Pythagorean Theorem Proof",
    "author": "lumina-demo",
    "created_at": "2026-04-30T00:00:00Z"
  },
  "canvas": {
    "width": 1920,
    "height": 1080,
    "fps": 60,
    "duration": 8.0,
    "background": "#0F0F1A"
  },
  "assets": {
    "fonts": [
      { "id": "sans", "path": "examples/assets/fonts/LiberationSans-Regular.ttf" }
    ]
  },
  "objects": {
    "triangle": {
      "type": "Polygon",
      "properties": {
        "points": [[0, 0], [300, 0], [0, 400]],
        "fill": "#1E3A5F",
        "stroke": "#4A90D9",
        "stroke_width": 2,
        "z_index": 1,
        "opacity": 0.0
      }
    },
    "side_a": {
      "type": "Arrow",
      "properties": {
        "from": [0, 0],
        "to": [300, 0],
        "color": "#E74C3C",
        "stroke_width": 3,
        "z_index": 2,
        "opacity": 0.0
      }
    },
    "side_b": {
      "type": "Arrow",
      "properties": {
        "from": [0, 0],
        "to": [0, 400],
        "color": "#2ECC71",
        "stroke_width": 3,
        "z_index": 2,
        "opacity": 0.0
      }
    },
    "side_c": {
      "type": "Arrow",
      "properties": {
        "from": [300, 0],
        "to": [0, 400],
        "color": "#F39C12",
        "stroke_width": 3,
        "z_index": 2,
        "opacity": 0.0
      }
    },
    "proof_group": {
      "type": "Group",
      "properties": {
        "children": ["triangle", "side_a", "side_b", "side_c"],
        "x": 760,
        "y": 240,
        "z_index": 1,
        "scale": 0.0,
        "rotation": 0.0,
        "opacity": 1.0
      }
    },
    "formula": {
      "type": "LaTeX",
      "properties": {
        "expression": "c^2 = a^2 + b^2",
        "x": 960,
        "y": 160,
        "font_size": 64,
        "color": "#FFFFFF",
        "z_index": 3,
        "opacity": 0.0
      }
    },
    "label_a": {
      "type": "Text",
      "properties": {
        "content": "a",
        "x": 1070,
        "y": 490,
        "font_size": 32,
        "color": "#E74C3C",
        "z_index": 3,
        "opacity": 0.0
      }
    },
    "label_b": {
      "type": "Text",
      "properties": {
        "content": "b",
        "x": 740,
        "y": 460,
        "font_size": 32,
        "color": "#2ECC71",
        "z_index": 3,
        "opacity": 0.0
      }
    },
    "label_c": {
      "type": "Text",
      "properties": {
        "content": "c",
        "x": 920,
        "y": 390,
        "font_size": 32,
        "color": "#F39C12",
        "z_index": 3,
        "opacity": 0.0
      }
    }
  },
  "timeline": [
    { "time": 0.0, "object": "proof_group", "state": { "scale": 0.0 }, "easing": "linear" },
    { "time": 1.5, "object": "proof_group", "state": { "scale": 1.0 }, "easing": "ease_out_cubic" },
    { "time": 0.5, "object": "side_a",      "state": { "opacity": 1.0 }, "easing": "ease_out_sine" },
    { "time": 1.0, "object": "side_b",      "state": { "opacity": 1.0 }, "easing": "ease_out_sine" },
    { "time": 1.5, "object": "side_c",      "state": { "opacity": 1.0 }, "easing": "ease_out_sine" },
    { "time": 0.3, "object": "label_a",     "state": { "opacity": 1.0 }, "easing": "ease_out_sine" },
    { "time": 0.8, "object": "label_b",     "state": { "opacity": 1.0 }, "easing": "ease_out_sine" },
    { "time": 1.3, "object": "label_c",     "state": { "opacity": 1.0 }, "easing": "ease_out_sine" },
    { "time": 2.5, "object": "formula",     "state": { "opacity": 0.0 }, "easing": "linear" },
    { "time": 4.0, "object": "formula",     "state": { "opacity": 1.0 }, "easing": "ease_out_cubic" },
    { "time": 5.5, "object": "formula",     "state": { "opacity": 1.0, "font_size": 80 }, "easing": "ease_in_out_sine" },
    { "time": 7.0, "object": "formula",     "state": { "opacity": 1.0, "font_size": 64 }, "easing": "ease_in_out_sine" }
  ],
  "events": [
    {
      "object": "triangle",
      "trigger": "click",
      "action": { "type": "jump_to_time", "value": 0.0 }
    }
  ]
}
