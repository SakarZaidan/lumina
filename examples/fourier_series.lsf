{
  "version": "1.0",
  "meta": {
    "title": "Fourier Series — Square Wave",
    "author": "Lumina",
    "created_at": "2026-05-20"
  },
  "canvas": {
    "width": 1280,
    "height": 720,
    "fps": 30,
    "duration": 12.0,
    "background": "#0A0A14"
  },
  "assets": {
    "fonts": [
      { "id": "sans", "path": "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf" }
    ]
  },
  "objects": {
    "title": {
      "type": "Text",
      "properties": {
        "content": "Fourier Series: Square Wave from Harmonics",
        "x": 60, "y": 56,
        "font_id": "sans", "font_size": 28,
        "color": "#E8EAED", "opacity": 0, "z_index": 10
      }
    },
    "axes": {
      "type": "Axes",
      "properties": {
        "x_range": [0, 6.28],
        "y_range": [-1.8, 1.8],
        "x": 100, "y": 400,
        "scale": 150,
        "x_step": 1.57,
        "y_step": 0.5,
        "grid": true,
        "color": "#3D5A80",
        "z_index": 1, "opacity": 0
      }
    },
    "h1": {
      "type": "Plot",
      "properties": {
        "function_str": "sin(x)",
        "axes_id": "axes",
        "color": "#FF6B6B",
        "stroke_width": 3,
        "sample_count": 300,
        "draw_fraction": 0.0,
        "z_index": 5, "opacity": 1
      }
    },
    "h3": {
      "type": "Plot",
      "properties": {
        "function_str": "sin(x) + sin(3*x)/3",
        "axes_id": "axes",
        "color": "#FFA500",
        "stroke_width": 3,
        "sample_count": 300,
        "draw_fraction": 0.0,
        "z_index": 6, "opacity": 0
      }
    },
    "h5": {
      "type": "Plot",
      "properties": {
        "function_str": "sin(x) + sin(3*x)/3 + sin(5*x)/5",
        "axes_id": "axes",
        "color": "#FFD700",
        "stroke_width": 3,
        "sample_count": 400,
        "draw_fraction": 0.0,
        "z_index": 7, "opacity": 0
      }
    },
    "h9": {
      "type": "Plot",
      "properties": {
        "function_str": "sin(x) + sin(3*x)/3 + sin(5*x)/5 + sin(7*x)/7 + sin(9*x)/9",
        "axes_id": "axes",
        "color": "#7FFF00",
        "stroke_width": 3,
        "sample_count": 500,
        "draw_fraction": 0.0,
        "z_index": 8, "opacity": 0
      }
    },
    "label_h1": {
      "type": "Text",
      "properties": {
        "content": "n=1: sin(x)",
        "x": 1000, "y": 180, "font_id": "sans", "font_size": 20,
        "color": "#FF6B6B", "opacity": 0, "z_index": 11
      }
    },
    "label_h3": {
      "type": "Text",
      "properties": {
        "content": "n=3: +sin(3x)/3",
        "x": 1000, "y": 220, "font_id": "sans", "font_size": 20,
        "color": "#FFA500", "opacity": 0, "z_index": 11
      }
    },
    "label_h5": {
      "type": "Text",
      "properties": {
        "content": "n=5: +sin(5x)/5",
        "x": 1000, "y": 260, "font_id": "sans", "font_size": 20,
        "color": "#FFD700", "opacity": 0, "z_index": 11
      }
    },
    "label_h9": {
      "type": "Text",
      "properties": {
        "content": "n=9: converging to square wave",
        "x": 1000, "y": 300, "font_id": "sans", "font_size": 20,
        "color": "#7FFF00", "opacity": 0, "z_index": 11
      }
    },
    "formula": {
      "type": "LaTeX",
      "properties": {
        "expression": "f(x) = (4/\\pi) \\sum_{n=1,3,5,...} sin(nx)/n",
        "x": 60, "y": 690, "font_size": 22, "font_id": "sans",
        "color": "#AAAAAA", "opacity": 0, "z_index": 12
      }
    }
  },
  "timeline": [
    { "time": 0.0, "object": "title",    "state": { "opacity": 0 }, "easing": "linear" },
    { "time": 0.8, "object": "title",    "state": { "opacity": 1 }, "easing": "ease_out_sine" },
    { "time": 0.5, "object": "axes",     "state": { "opacity": 0 }, "easing": "linear" },
    { "time": 1.5, "object": "axes",     "state": { "opacity": 1 }, "easing": "ease_out_cubic" },

    { "time": 1.5,  "object": "h1",     "state": { "draw_fraction": 0.0 }, "easing": "linear" },
    { "time": 3.0,  "object": "h1",     "state": { "draw_fraction": 1.0 }, "easing": "ease_out_cubic" },
    { "time": 1.5,  "object": "label_h1", "state": { "opacity": 0 }, "easing": "linear" },
    { "time": 2.0,  "object": "label_h1", "state": { "opacity": 1 }, "easing": "ease_out_sine" },

    { "time": 3.2,  "object": "h3",     "state": { "opacity": 1, "draw_fraction": 0.0 }, "easing": "linear" },
    { "time": 4.8,  "object": "h3",     "state": { "draw_fraction": 1.0 }, "easing": "ease_out_cubic" },
    { "time": 3.2,  "object": "label_h3", "state": { "opacity": 0 }, "easing": "linear" },
    { "time": 3.7,  "object": "label_h3", "state": { "opacity": 1 }, "easing": "ease_out_sine" },

    { "time": 5.2,  "object": "h5",     "state": { "opacity": 1, "draw_fraction": 0.0 }, "easing": "linear" },
    { "time": 7.0,  "object": "h5",     "state": { "draw_fraction": 1.0 }, "easing": "ease_out_cubic" },
    { "time": 5.2,  "object": "label_h5", "state": { "opacity": 0 }, "easing": "linear" },
    { "time": 5.7,  "object": "label_h5", "state": { "opacity": 1 }, "easing": "ease_out_sine" },

    { "time": 7.5,  "object": "h9",     "state": { "opacity": 1, "draw_fraction": 0.0 }, "easing": "linear" },
    { "time": 10.0, "object": "h9",     "state": { "draw_fraction": 1.0 }, "easing": "ease_out_cubic" },
    { "time": 7.5,  "object": "label_h9", "state": { "opacity": 0 }, "easing": "linear" },
    { "time": 8.0,  "object": "label_h9", "state": { "opacity": 1 }, "easing": "ease_out_sine" },

    { "time": 10.5, "object": "formula", "state": { "opacity": 0 }, "easing": "linear" },
    { "time": 11.5, "object": "formula", "state": { "opacity": 1 }, "easing": "ease_out_sine" }
  ],
  "events": []
}
