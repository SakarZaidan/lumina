{
  "version": "1.0",
  "meta": { "title": "Parity: SVG asset compositing", "author": "parity-harness", "created_at": "2026-07-12T00:00:00Z" },
  "canvas": { "width": 256, "height": 256, "fps": 30, "duration": 2.0, "background": "#0F0F1A" },
  "assets": {
    "images": [
      { "id": "node", "path": "examples/assets/lumina_node.svg" }
    ]
  },
  "objects": {
    "icon": {
      "type": "SVG",
      "properties": { "asset_id": "node", "x": 40, "y": 40, "width": 100, "height": 100, "z_index": 1 }
    },
    "icon_small": {
      "type": "SVG",
      "properties": { "asset_id": "node", "x": 160, "y": 140, "width": 60, "height": 60, "opacity": 0.7, "z_index": 2 }
    }
  },
  "timeline": [
    { "time": 0.0, "object": "icon", "state": { "opacity": 0.4 }, "easing": "linear" },
    { "time": 2.0, "object": "icon", "state": { "opacity": 1.0 }, "easing": "linear" }
  ]
}
