{
  "version": "1.0",
  "meta": { "title": "Parity: combined showcase", "author": "parity-harness", "created_at": "2026-07-12T00:00:00Z" },
  "canvas": { "width": 256, "height": 256, "fps": 30, "duration": 2.0, "background": "#0B1020" },
  "assets": {
    "fonts": [
      { "id": "sans", "path": "examples/assets/fonts/LiberationSans-Regular.ttf" }
    ]
  },
  "objects": {
    "banner": {
      "type": "Rectangle",
      "properties": { "x": 24, "y": 20, "width": 208, "height": 56, "rx": 12, "z_index": 1,
        "fill": { "type": "linear", "stops": [[0.0, "#4C6EF5"], [1.0, "#9775FA"]], "angle": 0 },
        "shadow": { "color": "#000000", "blur": 8, "dx": 0, "dy": 5, "opacity": 0.5 } }
    },
    "title": {
      "type": "Text",
      "properties": { "content": "Lumina", "x": 128, "y": 56, "font_size": 28, "color": "#FFFFFF", "align": "center", "z_index": 2 }
    },
    "cluster": {
      "type": "Group",
      "properties": { "children": ["core", "ring"], "x": 80, "y": 160, "scale": 1.0, "rotation": 0, "z_index": 3 }
    },
    "core": {
      "type": "Circle",
      "properties": { "cx": 0, "cy": 0, "radius": 26, "z_index": 1,
        "fill": { "type": "radial", "stops": [[0.0, "#FFF3BF"], [1.0, "#F08C00"]], "radius": 1.0 },
        "shadow": { "color": "#F08C00", "blur": 12, "dx": 0, "dy": 0, "opacity": 0.6 } }
    },
    "ring": {
      "type": "Circle",
      "properties": { "cx": 0, "cy": 0, "radius": 38, "fill": "#00000000", "stroke": "#FFD43B", "stroke_width": 2, "z_index": 2 }
    },
    "sparks": {
      "type": "Particles",
      "properties": { "count": 30, "emitter_x": 185, "emitter_y": 170, "lifetime": 1.4, "speed": 45, "spread": 360, "size": 3, "color": "#74C0FC", "z_index": 4 }
    },
    "reveal": {
      "type": "Line",
      "properties": { "x1": 30, "y1": 232, "x2": 226, "y2": 232, "stroke": "#63E6BE", "stroke_width": 3, "z_index": 5 }
    }
  },
  "timeline": [
    { "time": 0.0, "object": "cluster", "state": { "rotation": 0, "x": 80 }, "easing": "linear" },
    { "time": 2.0, "object": "cluster", "state": { "rotation": 60, "x": 95 }, "easing": "ease_in_out_cubic" },
    { "time": 0.0, "object": "reveal", "state": { "draw_fraction": 0.0 }, "easing": "linear" },
    { "time": 2.0, "object": "reveal", "state": { "draw_fraction": 1.0 }, "easing": "ease_out_quad" },
    { "time": 0.0, "object": "title", "state": { "opacity": 0.3 }, "easing": "linear" },
    { "time": 2.0, "object": "title", "state": { "opacity": 1.0 }, "easing": "linear" }
  ],
  "camera": {
    "timeline": [
      { "time": 0.0, "state": { "x": 0, "y": 0, "zoom": 1.0 }, "easing": "linear" },
      { "time": 2.0, "state": { "x": 10, "y": -8, "zoom": 1.15 }, "easing": "ease_in_out_quad" }
    ]
  }
}
