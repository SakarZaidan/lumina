{
  "version": "1.0",
  "meta": { "title": "Parity: nested groups", "author": "parity-harness", "created_at": "2026-07-12T00:00:00Z" },
  "canvas": { "width": 256, "height": 256, "fps": 30, "duration": 2.0, "background": "#0F0F1A" },
  "assets": {},
  "objects": {
    "outer": {
      "type": "Group",
      "properties": { "children": ["inner", "marker"], "x": 128, "y": 128, "scale": 1.0, "rotation": 0, "z_index": 1 }
    },
    "inner": {
      "type": "Group",
      "properties": { "children": ["dot", "bar"], "x": 30, "y": 0, "scale": 0.8, "rotation": 45, "z_index": 1 }
    },
    "marker": {
      "type": "Rectangle",
      "properties": { "x": -60, "y": -60, "width": 30, "height": 30, "fill": "#FF8787", "z_index": 2 }
    },
    "dot": {
      "type": "Circle",
      "properties": { "cx": 0, "cy": 0, "radius": 18, "fill": "#74C0FC", "z_index": 1 }
    },
    "bar": {
      "type": "Rectangle",
      "properties": { "x": -8, "y": 20, "width": 16, "height": 48, "fill": "#B197FC", "z_index": 2 }
    }
  },
  "timeline": [
    { "time": 0.0, "object": "outer", "state": { "rotation": 0, "scale": 1.0 }, "easing": "linear" },
    { "time": 2.0, "object": "outer", "state": { "rotation": 90, "scale": 1.3 }, "easing": "ease_in_out_cubic" },
    { "time": 2.0, "object": "inner", "state": { "x": -30 }, "easing": "ease_out_quad" }
  ]
}
