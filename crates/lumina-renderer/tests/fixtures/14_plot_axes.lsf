{
  "version": "1.0",
  "meta": { "title": "Parity: axes, plots, number line", "author": "parity-harness", "created_at": "2026-07-12T00:00:00Z" },
  "canvas": { "width": 256, "height": 256, "fps": 30, "duration": 2.0, "background": "#101018" },
  "assets": {},
  "objects": {
    "axes": {
      "type": "Axes",
      "properties": { "x": 40, "y": 128, "x_range": [-2, 4], "y_range": [-2, 2], "scale": 30, "color": "#868E96", "z_index": 1 }
    },
    "sine": {
      "type": "Plot",
      "properties": { "axes_id": "axes", "function_str": "math::sin(x * 2.0)", "color": "#4DABF7", "stroke_width": 2.5, "z_index": 2 }
    },
    "parabola": {
      "type": "Plot",
      "properties": { "axes_id": "axes", "function_str": "x * x - 1.0", "color": "#F783AC", "stroke_width": 2.0, "z_index": 3 }
    },
    "nline": {
      "type": "NumberLine",
      "properties": { "start": 0, "end": 10, "step": 2, "x": 30, "y": 230, "length": 196, "color": "#69DB7C", "z_index": 4 }
    }
  },
  "timeline": [
    { "time": 0.0, "object": "sine", "state": { "draw_fraction": 0.3 }, "easing": "linear" },
    { "time": 2.0, "object": "sine", "state": { "draw_fraction": 1.0 }, "easing": "ease_in_out_sine" }
  ]
}
