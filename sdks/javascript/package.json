{
  "name": "luminafx",
  "version": "0.6.0",
  "description": "Lumina Animation Engine \u2014 React and vanilla-JS player SDK",
  "license": "MIT",
  "author": "Sakar Hashim",
  "repository": {
    "type": "git",
    "url": "https://github.com/SakarZaidan/lumina"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "wasm"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build ../../crates/lumina-wasm --target web --out-dir ../../sdks/javascript/wasm && rm -f ../../sdks/javascript/wasm/.gitignore ../../sdks/javascript/wasm/package.json",
    "build": "npm run build:wasm && tsup src/index.ts --format cjs,esm --dts --out-dir dist",
    "typecheck": "npm run build:wasm && tsc --noEmit",
    "dev": "tsup src/index.ts --format esm --watch",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
